          "title": {
            "type": "string",
            "minLength": 1
          },
          "accessedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "const": "official"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "id",
          "title",
          "accessedAt",
          "kind",
          "url"
        ],
        "additionalProperties": false
      },
